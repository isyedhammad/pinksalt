# ==============================================================================
# PinkSalt Intelligence & Investment Portal - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration (Defaults to persistent SQLite file)
DATABASE_PATH=pinksalt.db

# Security & Sessions
SECRET_KEY=replace_with_a_secure_random_hex_key_for_production_sessions
SESSION_DURATION_HOURS=24

# External AI Provider (Optional)
# If provided, PinkSalt AI connects to the model with grounded retrieval.
# If omitted or unset, PinkSalt AI operates in Autonomous Grounded Knowledge Engine mode.
GEMINI_API_KEY=

# Administrative Superuser Bootstrap (Used on initial database seed)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=PinkSalt@2026!
ADMIN_CONTACT_EMAIL=directorate.minerals@punjab.gov.pk
